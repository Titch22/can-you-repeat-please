# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Hostnames (DNS A records pointing to this server).
GAME_DOMAIN=game.example.com
VOICE_DOMAIN=voice.example.com
SOUNDS_DOMAIN=sounds.example.com

# LiveKit API credentials, shared by the game server and LiveKit. Generate them with:
#   echo "LIVEKIT_API_KEY=cyrp$(openssl rand -hex 6)"
#   echo "LIVEKIT_API_SECRET=$(openssl rand -hex 32)"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Unlocks the sound library admin page (https://GAME_DOMAIN/admin). Generate it with:
#   echo "SOUNDS_ADMIN_TOKEN=$(openssl rand -hex 24)"
SOUNDS_ADMIN_TOKEN=
