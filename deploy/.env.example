# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Hostnames (DNS A records pointing to this server).
GAME_DOMAIN=game.example.com
VOICE_DOMAIN=voice.example.com
SOUNDS_DOMAIN=sounds.example.com

# LiveKit API credentials, shared by the game server and LiveKit. Generate them with:
#   echo "LIVEKIT_API_KEY=cyrp$(openssl rand -hex 6)"
#   echo "LIVEKIT_API_SECRET=$(openssl rand -hex 32)"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared by the game server and the sounds service: the game signs logged-in users' access to
# their sounds (https://GAME_DOMAIN/sounds) with it. Generate it with:
#   echo "SOUNDS_SECRET=$(openssl rand -hex 24)"
SOUNDS_SECRET=
# Room on the server for each user's own sounds (default 200).
USER_SOUNDS_QUOTA_MB=

# Accounts. Sign-up needs a code from an admin unless ACCOUNT_CREATION=open.
# On the first start (no account yet), a code for the first account is printed in
# `docker compose logs game`. Admins (comma-separated usernames) manage codes and reset
# passwords at https://GAME_DOMAIN/admin/accounts.
ACCOUNT_CREATION=
ADMIN_USERNAMES=

# Sounds from YouTube links: true to turn on (off by default). Needs YouTube to accept the
# server (see docs/DEPLOYMENT.md, "YouTube cookies").
ENABLE_YOUTUBE_DOWNLOADS=false
# Optional: cookies of a signed-in YouTube session, past YouTube's bot check (see
# docs/DEPLOYMENT.md, "YouTube cookies"). A path inside the sounds container.
YTDLP_COOKIES=
