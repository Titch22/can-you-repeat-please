# nginx sites for the game. Copy to /etc/nginx/sites-available/cyrp, replace the three
# hostnames, enable it, then run certbot to add HTTPS. See docs/DEPLOYMENT.md.

# Disk cache for library audio files (sounds.example.com/files/).
proxy_cache_path /var/cache/nginx/cyrp_sounds levels=1:2 keys_zone=cyrp_sounds:10m max_size=2g
                 inactive=30d use_temp_path=off;

# WebSocket upgrade helper. If another site already defines $connection_upgrade, delete this block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The game: web app, API, Socket.IO.
server {
    listen 80;
    listen [::]:80;
    server_name game.example.com;

    # Recording uploads are at most 2 MB.
    client_max_body_size 3m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Socket.IO connections stay open for the whole session.
        proxy_read_timeout 1h;
    }
}

# Sound library: listings, audio files and admin uploads. Audio files never change (their name
# is their content hash): nginx keeps a copy of each, and browsers cache them for a year.
server {
    listen 80;
    listen [::]:80;
    server_name sounds.example.com;

    # Admin uploads are at most 2 MB.
    client_max_body_size 3m;

    location /files/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_cache cyrp_sounds;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# LiveKit signaling (media itself goes straight to ports 7881/tcp and 7882/udp).
server {
    listen 80;
    listen [::]:80;
    server_name voice.example.com;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }
}
