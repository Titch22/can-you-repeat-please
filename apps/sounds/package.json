{
  "name": "@cyrp/sounds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The sound library: curated sounds with tags, served with long-lived cache headers.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "import": "tsx --env-file-if-exists=.env src/cli/import.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyrp/audio": "workspace:^",
    "@cyrp/shared": "workspace:^",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "music-metadata": "^12.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
