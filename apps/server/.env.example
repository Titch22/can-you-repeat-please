PORT=3000
# Comma-separated origins allowed for CORS (the Vite dev server proxies, so this is mostly for prod)
CLIENT_ORIGIN=http://localhost:5173

# LiveKit: these values match `docker compose up` / `livekit-server --dev`
LIVEKIT_URL=ws://localhost:7880
# URL browsers connect to (defaults to LIVEKIT_URL). Set it when LiveKit is public, e.g. wss://voice.example.com
# LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
