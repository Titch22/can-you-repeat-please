    "livekit-server-sdk": "^2.19.1",
    "music-metadata": "^12.2.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
